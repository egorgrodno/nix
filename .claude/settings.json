{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(nix-instantiate:*)",
      "Bash(nix-store:*)",
      "Bash(nix:*)",
      "Bash(nixos-option:*)",
      "Bash(nxc)",
      "Bash(sleep:*)",
      "Bash(type:*)",
      "Bash(which:*)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f || exit 0; case \"$f\" in /etc/nixos/*) nix fmt -- --no-cache -- \"$f\" >/dev/null 2>&1 || true;; esac; }",
            "timeout": 30,
            "statusMessage": "nix fmt"
          }
        ]
      }
    ]
  }
}
